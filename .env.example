# ──────────────────────────────────────────────────────────────────────────────
# MediFlow — Environment Variables
# Copy this file to .env and fill in the values.
# .env is git-ignored. NEVER commit real secrets.
#
# See docs/08-local-setup.md for detailed setup instructions.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core (required) ─────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev example: postgres://mediflow:mediflow@localhost:5432/mediflow
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mediflow

# Node environment. Use "development" locally, "production" on the server.
NODE_ENV=development

# ─── Security (required in production) ───────────────────────────────────────

# 32-byte random key encoded as base64.
# Generate with: openssl rand -base64 32
# Required when NODE_ENV=production. Used to encrypt WhatsApp/SMS secrets at rest.
APP_ENCRYPTION_KEY=

# Shared bearer token for /api/cron/* routes.
# Generate with: openssl rand -hex 32
# Required when NODE_ENV=production.
CRON_SECRET=

# ─── WhatsApp Business API (optional) ────────────────────────────────────────

# Verification token set in Meta Developer Console → Webhook → Verify Token.
WHATSAPP_VERIFY_TOKEN=

# App Secret from Meta Developer Console → App Settings → Basic.
# Used to verify X-Hub-Signature-256 on incoming webhook requests.
WHATSAPP_APP_SECRET=

# ─── E-Invoice / GST (optional) ──────────────────────────────────────────────

# Controls e-invoice behaviour:
#   disabled    (default) — all e-invoice actions throw a clear error
#   simulator   — generates IRNs locally without calling any external API
#   sandbox     — calls a real GSP sandbox endpoint (needs GSP credentials)
#   production  — calls the live NIC IRP via a GSP (needs GSP credentials)
EINVOICE_MODE=disabled

# ─── AI Providers (all optional) ─────────────────────────────────────────────

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Cohere API key — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Tavily Search API key — https://app.tavily.com
TAVILY_API_KEY=

# ─── Google OAuth 2.0 (optional) ─────────────────────────────────────────────

# Canonical public URL of the app (used for OAuth callback redirect_uri).
# Local dev default if unset: http://localhost:3000
APP_URL=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
