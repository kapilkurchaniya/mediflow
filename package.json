    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-safe-action": "^8.7.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
