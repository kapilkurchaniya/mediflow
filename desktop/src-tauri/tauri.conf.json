{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediFlow POS Desktop",
  "version": "0.1.0",
  "identifier": "com.mediflow.pos.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000/dashboard/sales/pos",
    "beforeBuildCommand": "",
    "frontendDist": "../../out"
  },
  "app": {
    "windows": [
      {
        "title": "MediFlow POS Terminal",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
